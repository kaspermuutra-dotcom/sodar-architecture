# Copy to .env.local and fill in from the Supabase dashboard (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server/worker only. Never prefix with NEXT_PUBLIC_ and never expose to browsers.
SUPABASE_SERVICE_ROLE_KEY=

# Worker process (SUPABASE_URL may equal NEXT_PUBLIC_SUPABASE_URL).
SUPABASE_URL=
SODAR_WORKER_ID=

# Contact form: Formspree form id (https://formspree.io) — messages go to team@sodar.io. Falls back to mailto when unset.
NEXT_PUBLIC_FORMSPREE_ID=
# Privacy contact form on /legal/privacy — a separate Formspree form that delivers to privacy@sodar.io.
NEXT_PUBLIC_FORMSPREE_PRIVACY_ID=

# ---------------------------------------------------------------------------
# AI providers — all server-only. Never put a real value in this file.
# ---------------------------------------------------------------------------
# GPT-6 Astra capture review and GPT Image 2 panorama completion share this key.
OPENAI_API_KEY=
OPENAI_ASTRA_MODEL=gpt-6-astra
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
# Set to 1 to offer the GPT Image 2 completion automatically after each room (the person still confirms).
NEXT_PUBLIC_AI_FILL=0

# KIRI Engine — faithful photo-based 3D Gaussian splatting (docs.kiriengine.app).
KIRI_API_KEY=
# Optional override; must be https. Default https://api.kiriengine.app/api
KIRI_API_BASE_URL=
# Shared secret configured with the KIRI webhook (6–40 chars). Callback URL: https://<host>/api/webhooks/kiri
KIRI_WEBHOOK_SECRET=

# World Labs Marble — explorable world generation (docs.worldlabs.ai/api).
WORLDLABS_API_KEY=
# marble-1.0-draft | marble-1.0 | marble-1.1 (default) | marble-1.1-plus
WORLDLABS_MODEL=marble-1.1
WORLDLABS_API_BASE_URL=

# Provider flags and kill switches (1/0). A provider is also disabled when its key is missing.
KIRI_ENABLED=1
WORLDLABS_ENABLED=1
ASTRA_ENABLED=1
AI_FILL_ENABLED=1
# kiri_only | marble_only | dual (default)
RECONSTRUCTION_MODE=dual
# Set to 1 to pause every paid operation immediately (submissions, Astra, AI fill). Polling and downloads continue.
RECONSTRUCTION_KILL_SWITCH=0

# Cost controls
SODAR_DAILY_JOBS_PER_USER=6
SODAR_DAILY_ASTRA_PER_USER=60
SODAR_DAILY_AI_FILL_PER_USER=20
SODAR_MAX_IMAGES_PER_JOB=300
SODAR_MAX_ROOMS_PER_SCAN=12
KIRI_MIN_BALANCE=1
WORLDLABS_MIN_BALANCE=1600

# Bearer secret for the scheduled poller GET /api/reconstruction/poll (Vercel Cron or any scheduler).
CRON_SECRET=

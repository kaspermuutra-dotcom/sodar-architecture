# Supabase — copy to .env and fill in. .env is gitignored; never commit real values.

# Project identity
SUPABASE_PROJECT_REF=          # e.g. abcdefghijklmnop (from the project URL / dashboard)
SUPABASE_URL=                  # https://<ref>.supabase.co

# API keys (Project Settings → API)
SUPABASE_ANON_KEY=             # client-safe, RLS-enforced
SUPABASE_SERVICE_ROLE_KEY=     # server-only, bypasses RLS — treat as a root secret

# Direct Postgres connection (Project Settings → Database → Connection string)
SUPABASE_DB_URL=               # postgresql://postgres:<pw>@db.<ref>.supabase.co:5432/postgres

# Management API / CLI (account-level access token, https://supabase.com/dashboard/account/tokens)
SUPABASE_ACCESS_TOKEN=
